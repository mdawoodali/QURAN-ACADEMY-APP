# ==============================================================================
# Quran Academy — Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# Never commit real API secrets to version control.
# ==============================================================================

# 1. Supabase / PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-jwt"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-jwt"

# 2. LiveKit Cloud WebRTC Configuration
# Sign up at https://livekit.io for free tier credentials
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# 3. Deepgram Ultra-Low Latency Speech-to-Text
# Sign up at https://deepgram.com for developer credits
DEEPGRAM_API_KEY="your_deepgram_api_key"

# 4. Multi-Currency Direct Bank Wire & Raast Configuration (Zero Stripe)
NEXT_PUBLIC_PAYMENT_CURRENCIES="GBP,USD,CAD,EUR,AUD,PKR"
ACADEMY_BANK_NAME="Meezan Bank / Barclays"
ACADEMY_IBAN="PK36MEZN0000000000000000"
ACADEMY_RAAST_ID="03001234567"
ACADEMY_SWIFT_CODE="MEZNPKKA"

# 5. Transactional Email via Resend
RESEND_API_KEY="re_..."
EMAIL_FROM="Quran Learn Academy <classes@quranlearnacademy.com>"

# 6. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
