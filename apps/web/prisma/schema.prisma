generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  role      String   // student, teacher, admin, parent
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  studentDetails StudentDetail?
  teacherDetails TeacherDetail?
  taughtClasses  Class[]        @relation("TeacherClasses")
  studentClasses Class[]        @relation("StudentClasses")

  @@map("profiles")
}

model StudentDetail {
  id         String   @id @default(uuid())
  fatherName String   @map("father_name")
  age        Int
  country    String
  city       String
  postalCode String   @map("postal_code")
  address    String
  parentId   String?  @map("parent_id")

  profile Profile @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("student_details")
}

model TeacherDetail {
  id           String  @id @default(uuid())
  idCardNumber String  @unique @map("id_card_number")
  phoneNumber  String  @map("phone_number")
  address      String
  qualification String
  maslak       String?
  fiqh         String?
  gender       String
  age          Int
  bankAccount  String  @map("bank_account")
  status       String  @default("pending")
  adminNotes   String? @map("admin_notes")

  profile Profile @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("teacher_details")
}

model Course {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  level       String
  targetAge   String   @map("target_age")
  classes     Class[]
  modules     CourseModule[]

  @@map("courses")
}

model CourseModule {
  id          String         @id @default(uuid())
  courseId    String         @map("course_id")
  title       String
  description String?
  orderIndex  Int            @map("order_index")
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]

  @@map("course_modules")
}

model CourseLesson {
  id             String       @id @default(uuid())
  moduleId       String       @map("module_id")
  title          String
  planType       String       @default("lesson") @map("plan_type")
  contentSummary String       @map("content_summary")
  orderIndex     Int          @map("order_index")
  module         CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("course_lessons")
}

model Class {
  id             String   @id @default(uuid())
  courseId       String?  @map("course_id")
  teacherId      String   @map("teacher_id")
  studentId      String   @map("student_id")
  startTime      DateTime @map("start_time")
  endTime        DateTime? @map("end_time")
  status         String   @default("scheduled")
  zoomOrMeetLink String?  @map("zoom_or_meet_link")
  createdAt      DateTime @default(now()) @map("created_at")

  course  Course? @relation(fields: [courseId], references: [id])
  teacher Profile @relation("TeacherClasses", fields: [teacherId], references: [id])
  student Profile @relation("StudentClasses", fields: [studentId], references: [id])

  @@map("classes")
}
