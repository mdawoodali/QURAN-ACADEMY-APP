{
  "name": "quran-academy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:ws": "pnpm --filter @quran/ws dev",
    "dev:all": "pnpm -r --parallel dev",
    "build": "pnpm --filter frontend build",
    "gen:feature": "node scripts/gen-feature.js",
    "check:arch": "dependency-cruiser apps/web/src"
  },
  "devDependencies": {
    "dependency-cruiser": "^15.5.0",
    "eslint-plugin-security": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
